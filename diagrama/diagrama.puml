@startuml Diagrama de Clases TP
    title "Diagrama de Clases\nTrabajo Práctico"
    
     enum EstadoPedido {
        EN_CONSTRUCCION
        CONFIRMADO
        FACTURADO
    }

    enum Categoria {
        ENTRADA
        PLATO_PRINCIPAL
        BEBIDA
        POSTRE
    }

    enum EstadoItem {
        PENDIENTE
        EN_PREPARACION
        LISTO
    }

    enum TipoEstacion {
        BARRA
        COCINA_DULCE
        COCINA_FRIA
        PARRILLA
    }

    enum TipoMedioPago {
        EFECTIVO
        BILLETERA_VIRTUAL
        TARJETA
    }

    '-------------Restaurante-Sistema-----------------------

    class Restaurante {
        -menu:Menu
        -cocinas:Cocina[]
        -gestorPedidos:GestorPedidos
        -gestorPagos:GestorPagos
    }

    '------------------ PEDIDOS -------------------------

    abstract class Pedido {
        ' -idPedido: number
        -items: ItemPedido[]
        -estado: EstadoPedido
        -precioFinal: number

        +puedeModificarse():boolean
        +agregarItem(item:ItemIndividual):void
        +sacarItem(item:ItemIndividual):void
        +setEstado(estado: EstadoPedido): void
        +deshacerUltimaModificacion():void
        +listoParaFacturar():boolean
        ' +facturar():void
        +calcularTotalCobrar():number

    }

    class PedidoSalon {
        -nMesa: number
    }

    class PedidoRetirar {
        -horario: number
    }

    class PedidoEnvio {
        -direccion: string
        -costoEnvio: number
    }

    '------------ MENU / PRODUCTOS -------------

    class Menu {
        -entradas: itemIndividual[]
        -platosPrincipales: itemIndividual[]
        -bebidas: itemIndividual[]
        -postres: itemIndividual[]
        -combos: Combo[]

        +agregarProducto(producto:Producto):void
        +sacarProducto(producto:Producto):void
        +getProductoPorCategoria(categoria:Categoria):Producto[]
    }

    interface Producto {
        +getPrecio(): number
    }

    abstract class Item { 
        -nombre: string
        -precio: number
        -categoria: Categoria
        -estacion: TipoEstacion

        +getPrecio(): number
        +getCategoria(): Categoria
    }

    class ItemIndividual extends Item {}

    class ItemPedido extends Item {
        -estado: EstadoItem
        -cantidad: number

        +marcarEnPreparacion():void
        +marcarListo():void
    }

    class Combo{
        -productos: ItemIndividual[]
    }

    '--------------------- COCINA ----------------------

    abstract class Cocina {
        -nombre:string
        -items: ItemIndividual[]

        +recibirItem(item: ItemIndividual): void
        +cocinarItem(item: itemIndividual): void
    }

    class Parrilla{}
    class CocinaDulce{}
    class CocinaFria{}
    class Barra{}

    '------------------ DESCUENTO -----------------

    interface DescuentoBeneficioso {
        +calcularDescuento(): number
    }
    '------------------ GESTOR_PAGOS -------------------------

    class GestorPagos {
        -medioPago: MedioPago
        -descuentoDia: DescuentoDia

        +calcularDescuento(): number
        +Cobrar(pedido: Pedido): Factura
    }
    '------------------- Factura ------------------------
    class Factura {
        -idFactura: string
        -pedido: Pedido
        -montoFinal: number

        ----getters----
    }

    '------------------- MedioPago ------------------------

    abstract MedioPago {
        #saldoDisponible: number
        #tipoMedioPago: TipoMedioPago
        +constructor(tipoPago:TipoMedioPago)
        
        +Pagar(monto:number): boolean
    }

    class Efectivo {}

    class Tarjeta{
        -numero:string
        -tipo:TipoTarjeta
    }
    
    class BilleteraVirtual{}

    class DescuentoDia{
        -dia:string
        -porcentaje:number
    }

    '-------------------- Gestor de Pedidos ------------------------

    class GestorPedidos{
        -pedidosFinalizados:Map<number, Pedido>

        +consultarHistorial():void
        +crearPedido() : Pedido
        +confirmarPedido(pedido:Pedido):void
        +registrarPedido(pedido:Pedido):void
    }

    '-------------------- RELACIONES ------------------------

'RESTAURANTE

    Restaurante *-r- Menu
    Restaurante *-- Cocina
    'Restaurante o-- Pedido
    Restaurante *-d- GestorPedidos
    Restaurante *--l--- GestorPagos
    'Restaurante ..|> Descuento

'PEDIDOS

    Pedido <|-d- PedidoSalon
    Pedido <|-d- PedidoRetirar
    Pedido <|-d- PedidoEnvio
    Pedido --* ItemPedido

'MENU

    Menu *-- ItemIndividual
    Menu *-d- Combo
    Combo *-l- ItemIndividual
    Combo ..|> Producto

'COCINA

    Parrilla -u-|> Cocina
    CocinaDulce -u-|> Cocina
    CocinaFria -u-|> Cocina
    Barra -u-|> Cocina
    ItemPedido <-- Cocina

'GESTOR DE PAGOS

    GestorPagos -l-* MedioPago
    GestorPagos --o DescuentoDia
    GestorPagos -u-o Factura
    GestorPagos -u-o DescuentoBeneficioso

'MEDIOS DE PAGO

    Efectivo -u-|> MedioPago
    Tarjeta -r-|> MedioPago
    BilleteraVirtual -d-|> MedioPago
    'Efectivo .d.|> Descuento

'DESCUENTOS

    'DescuentoDia ..|> Descuento

'GESTOR DE PEDIDOS

    'HistorialPedido o-- Pedido
    GestorPedidos *-- Pedido
    'Un pedido contiene exactamente Un registro en historial de Pedidos
    'HistorialPedido puede contener 0 o muchos pedidos.

    Item .d.|> Producto
@enduml
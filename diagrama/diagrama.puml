@startuml Diagrama de Clases TP
    title "Diagrama de Clases\nTrabajo Práctico"
    
     enum EstadoPedido{
        EN_CONSTRUCCION
        CONFIRMADO
        FACTURADO
    }

    enum Categoria{
        ENTRADA
        PLATO_PRINCIPAL
        BEBIDA
        POSTRE
    }

    enum EstadoItem{
        PENDIENTE
        EN_PREPARACION
        LISTO
    }
    enum TipoTarjeta{
        DEBITO
        CREDITO
    }
    '-------------Restaurante-Sistema-----------------------
    class Restaurante{
        -menu:Menu
        -cocinas:Cocina[]
        -descuentos:Descuento[]
        -historialPedidos:Pedido[]

        +registrarPedido(pedido:Pedido):void
        +confirmarPedido(pedido:Pedido):void
        +facturarPedido(pedido:Pedido):void
        +consultarHistorial():void
    }
    Restaurante -r-* Menu
    'Restaurante --* Cocina
    'Restaurante o-- Pedido
    Restaurante -d-* GestorPedidos
    Restaurante --l-* GestorPagos
    'Restaurante ..|> Descuento

   
    
    '------------------ PEDIDOS -------------------------

    abstract class Pedido {
        -id_pedido: number
        -items: ItemPedido[]
        -estado: EstadoPedido
        -medioPago:MedioPago
        -totalCobrado:number        

        +puedeModificarse():boolean
        +agregarItem(item:ItemPedido):void
        +sacarItem(item:ItemPedido):void
        +calcularPrecioFinal(): number
        +setEstado(estado: EstadoPedido): void
        +getEstado(): EstadoPedido
        +deshacerUltimaModificacion():void
        +estaListoParaFacturar():boolean
        +facturar():void
        +calcularTotalCobrar():number

    }

    class PedidoSalon {
        -nMesa: number
    }

    class PedidoRetirar {
        -horario: number
    }

    class PedidoEnvio {
        -direccion: string
        -costoEnvio: number
    }

    PedidoSalon -u-|> Pedido
    PedidoRetirar -u-|> Pedido
    PedidoEnvio -u-|> Pedido

    Pedido -r-* ItemIndividual
    Pedido --* Cocina
    Pedido ..|> Producto

    '------------ MENU / PRODUCTOS -------------

    class Menu {
        -productos: ProductoIndividual[]
        -combos: Combo[]

        +agregarProducto(producto:Producto):void
        +sacarProducto(producto:Producto):void
        +getProductoPorCategoria(categoria:Categoria):Producto[]
    }

    interface Producto {

        +getPrecio(): number
    }

    class ItemIndividual {
        -nombre: string
        -precio: number
        -estado: EstadoItem
        -categoria: Categoria
        -cantidad: number

        +getPrecio(): number
        +getCategoria(): Categoria
        +marcarEnPreparacion():void
        +marcarListo():void
    }

    class Combo  {
        -productos: ProductoIndividual[]
        -beneficio: Beneficio

        +getPrecio(): number
        +getCategorias():Categoria[]
    }

    ItemIndividual ..|> Producto
    Menu --* ItemIndividual
    Menu --* Combo
    Combo --* ItemIndividual
    Combo ..|> Producto

    '------------------ BENEFICIOS -----------------

    interface Beneficio {
        +calcularBeneficio(precioBase: number): number
    }

    class BeneficioPorcentual {
        -porcentaje: number
    }

    class BeneficioPrecioFijo {
        -precio: number
    }

    'BeneficioPorcentual ..|> Beneficio
    'BeneficioPrecioFijo ..|> Beneficio

    'Combo ..|> Beneficio

    '--------------------- COCINA ----------------------

    abstract class Cocina {
        -nombre:string
        -items: ItemPedido[]

        +recibirItem(item: ItemPedido): void
        +procesarSiguiente(): void
    }

    class Parrilla{}
    class CocinaDulce{}
    class CocinaFria{}
    class Barra{}

    Parrilla -u-|> Cocina
    CocinaDulce -u-|> Cocina
    CocinaFria -u-|> Cocina
    Barra -u-|> Cocina

    '------------------ GESTOR_PAGOS -------------------------
    class GestorPagos {
        -medioPago: MedioPago

        +Cobrar(): Factura
    }
    GestorPagos -l-* MedioPago

    '------------------- MedioPago ------------------------
    abstract class MedioPago{
        
        +Pagar()
    }
    class Efectivo{}
    class Tarjeta{
        -numero:string
        -tipo:TipoTarjeta
    }
    'Implementacion de Enum TipoTarjeta (a confirmar cambios)
    'class TarjetaDebito{}
    'class TarjetaCredito{}
    class BilleteraVirtual{}
    Efectivo -u-|> MedioPago
    Tarjeta -u-|> MedioPago
    BilleteraVirtual -u-|> MedioPago

    'TarjetaDebito --|> Tarjeta
    'TarjetaCredito --|> Tarjeta

    interface Descuento{
        +calcularDescuento(pedido:Pedido):number
    }
    class DescuentoEfectivo{
        -porcentaje:number
    }
    class DescuentoDia{
        -dia:string
        -porcentaje:number
    }
    DescuentoEfectivo ..|> Descuento
    DescuentoDia ..|> Descuento

    '-------------------- Historial------------------------
    class GestorPedidos{
        -pedidosFinalizados:Map<number, Pedido>
        +agregarPedido(pedido:Pedido):void
        +consultarPedidos():Pedido[]
    }
    'HistorialPedido o-- Pedido
    GestorPedidos "1" -d-> "0..*" Pedido
    'Un pedido contiene exactamente Un registro en historial de Pedidos
    'HistorialPedido puede contener 0 o muchos pedidos.
@enduml
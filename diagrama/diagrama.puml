@startuml Diagrama de Clases TP
    title "Diagrama de Clases\nTrabajo Práctico"
    
     enum EstadoPedido {
        EN_CONSTRUCCION
        CONFIRMADO
        FACTURADO
    }

    enum Categoria {
        ENTRADA
        PLATO_PRINCIPAL
        BEBIDA
        POSTRE
    }

    enum EstadoItem {
        PENDIENTE
        EN_PREPARACION
        LISTO
    }

    enum TipoEstacion {
        BARRA
        COCINA_DULCE
        COCINA_FRIA
        PARRILLA
    }

    enum TipoMedioPago {
        EFECTIVO
        BILLETERA_VIRTUAL
        TARJETA
    }

    enum DiaSemana {
        DOMINGO
        LUNES
        MARTES
        MIERCOLES
        JUEVES
        VIERNES
        SABADO
    }
    '-------------Restaurante-Sistema-----------------------

    class Restaurante {
        -menu:Menu
        -cocinas:Cocina[]
        -gestorPedidos:GestorPedidos
        -gestorPagos:GestorPagos
    }

    '------------------ PEDIDOS -------------------------

    abstract class Pedido {
        ' -idPedido: number
        '-items: ItemPedido[]
        '-estado: EstadoPedido
        '-precioFinal: number

        -items: List<ItemPedido>
        -estado: EstadoPedido
        -precioFinal: number
        -cargoAdicional: number
        -identificador : number
        -historialModificaciones: ItemPedido[]
        -fecha: Date

        +puedeModificarse():boolean
        +agregarItem(item:ItemIndividual):void
        +sacarItem(item:ItemIndividual):void
        +setEstado(estado: EstadoPedido): void
        +deshacerUltimaModificacion():void
        +listoParaFacturar():boolean
        ' +facturar():void
        +calcularTotalCobrar():number

    }

    class PedidoSalon {
        -nMesa: number
    }

    class PedidoRetirar {
        -horario: number
    }

    class PedidoEnvio {
        -direccion: string
        -costoEnvio: number
    }

    class ListaEnlazada<T> {
        -head: MyNode<T>
        +getHead() : MyNode<T>
        +push(value: T): MyNode<T>
        +removeLast(): T
        +insertFirst(value: T): MyNode<T>
        +removeFirst(): T
        +insertOrdered(value: T): MyNode<T>
        +insertUnique(value: T): MyNode<T>
        +delete(value: T): T
        +search(value: T): MyNode<T>
        +sort(): void
        +clear(): void
    }

    class MyNode<T> {
        -value : T;
        -next : MyNode<T>;
        +getValue() : T
        +getNext() : MyNode<T>
        +setNext(node : MyNode<T>) : void
    }
    '------------ MENU / PRODUCTOS -------------

    class Menu {
        -entradas: itemIndividual[]
        -platosPrincipales: itemIndividual[]
        -bebidas: itemIndividual[]
        -postres: itemIndividual[]
        -combos: Combo[]

        +agregarItem(item:ItemIndividual):void
        +sacarItem(item:ItemIndividual):void
        +agregarCombo(combo:Combo):void
        +sacarCombo(combo:Combo):void
        +getItemPorCategoria(categoria:Categoria):List<ItemIndividual>
    }

    interface Producto {
        +getPrecio(): number
    }

    abstract class Item { 
        -nombre: string
        -precio: number
        
        +getPrecio(): number
        +getComponentes(): ItemIndividual[]
    }

    class ItemIndividual {
        -categoria: Categoria
        -estacion: TipoEstacion
        
        +getCategoria(): Categoria
        +getTipoEstacion(): TipoEstacion
        +getPrecio(): number
        +getComponentes(): ItemIndividual[]
    }

    class ItemPedido {
        -item: Item
        -estado: EstadoItem
        -cantidad: number

        +marcarEnPreparacion():void
        +marcarListo():void
    }

    class Combo {
        -items: ItemIndividual[]
        
        +aplicarBeneficio(): number
        +getPrecio(): number
        +getComponentes(): ItemIndividual[]
    }

    interface BeneficioCombo {
        aplicarBeneficio(): number
    }

    note right of Combo::getComponentes()
        
        return this.items
    
    end note
    '--------------------- COCINA ----------------------

    abstract class Cocina {
        -nombre:string
        -items: ItemIndividual[]

        +recibirItem(item: ItemIndividual): void
        +cocinarItem(item: itemIndividual): void
    }

    class Parrilla{}
    class CocinaDulce{}
    class CocinaFria{}
    class Barra{}

    '------------------ DESCUENTO -----------------

    interface DescuentoBeneficioso {
        +calcularDescuento(): number
    }
    '------------------ GESTOR_PAGOS -------------------------

    class GestorPagos {
        -medioPago: MedioPago
        -descuentoDia: DescuentoDia

        +calcularDescuento(): number
        +Cobrar(pedido: Pedido): Factura
    }
    '------------------- Factura ------------------------
    class Factura {
        -idFactura: string
        -pedido: Pedido
        -montoFinal: number
        +constructor(pedido:Pedido, montoFinal:number)
        +setIdFactura(idFactura:number):void
        +getIdFactura():number
        +getInfoPedido(): string
    }

    '------------------- MedioPago ------------------------

    abstract MedioPago {
        #tipoMedioPago: TipoMedioPago
        +constructor(tipoPago:TipoMedioPago)
    }

    class DescuentoDia{
        -dia: DiaSemana
        -porcentaje:number
    }

    '-------------------- Gestor de Pedidos ------------------------

    class GestorPedidos{
        -pedidosTotales: Map<number, Pedido>
        -cantidadPedidos: number
        -pedidosFinalizados:Map<number, Factura>

        +consultarHistorial(): void
        +registrarPedidoFinalizado(factura:Factura): void
        -getCantidadPedidosFinalizados(): number
        +crearPedidoSalon(mesa:number): void
        +crearPedidoRetirar(horario:number): void
        +crearPedidoEnvio(direccion:string): void
        +registrarPedido(pedido:Pedido): void
    }
        '+confirmarPedido(pedido:Pedido): void

    '-------------------- RELACIONES ------------------------

'RESTAURANTE
    Restaurante *-r- Menu
    Restaurante -[hidden]r- Menu
    Restaurante *-- Cocina
    Restaurante *-d- GestorPedidos
    Restaurante *--l--- GestorPagos

'PEDIDOS
    Pedido <|-d- PedidoSalon
    Pedido <|-d- PedidoRetirar
    Pedido <|-d- PedidoEnvio
    Pedido --* ItemPedido
    Pedido -r-> EstadoPedido
    Pedido *-l- ListaEnlazada
    ListaEnlazada *-r- MyNode

'MENU
    Menu *-- ItemIndividual
    Menu *-d- Combo
    Combo -l-> ItemIndividual
    Combo --|> Item
    Combo ..|> BeneficioCombo
    ItemIndividual --|> Item
    Item .r.|> Producto
    ItemPedido -u-> Item

    Menu -[hidden]u- Categoria
'COCINA
    Parrilla -u-|> Cocina
    CocinaDulce -u-|> Cocina
    CocinaFria -u-|> Cocina
    Barra -u-|> Cocina
    ItemPedido <-- Cocina

'GESTOR DE PAGOS
    GestorPagos -l-* MedioPago
    GestorPagos --o DescuentoDia
    GestorPagos -u-o Factura
    GestorPagos -u-o DescuentoBeneficioso
    GestorPagos --> GestorPedidos
    DescuentoDia -l-> DiaSemana

    MedioPago -[hidden]u- DescuentoBeneficioso
'MEDIOS DE PAGO
    MedioPago -d-> TipoMedioPago

'GESTOR DE PEDIDOS
    GestorPedidos o--> Pedido

@enduml